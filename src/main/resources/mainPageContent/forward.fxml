<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox alignment="CENTER" prefHeight="463.0" prefWidth="514.0" stylesheets="/mainPageContent/contentsStyles.css" xmlns="http://javafx.com/javafx/11.0.14-internal" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.email.sys.controllers.ForwardEmailController">
    <HBox alignment="CENTER" spacing="30.0">
        <TextField fx:id="userSearch" minWidth="150" prefHeight="25.0" prefWidth="151.0" promptText="Enter user's email" styleClass="search-bar" />
        <Button fx:id="searchButton" styleClass="secondary-button" text="Search" />
        <padding>
            <Insets bottom="20.0" />
        </padding>
    </HBox>
    <ListView fx:id="usersList" prefHeight="200.0" prefWidth="200.0" styleClass="email-list">
        <VBox.margin>
            <Insets left="40.0" right="40.0" />
        </VBox.margin>
    </ListView>
    <HBox alignment="CENTER" prefHeight="100.0" prefWidth="200.0" spacing="30.0">
        <Button fx:id="sendButton" mnemonicParsing="false" styleClass="primary-button" text="Send" />
        <Button fx:id="backButton" mnemonicParsing="false" styleClass="back-button" text="Back" />
    </HBox>
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>
</VBox>
